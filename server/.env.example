# 이 파일을 .env 로 복사해 값을 채운다 (.env 는 git에 올리지 않는다)

# 1 = 테스트 모드(실제 발송 안 함, 기본값) / 0 = 실제 발송
DRY_RUN=1
PORT=8787

# 앱 → 서버 접속 토큰 (설정 › 규칙·훅·채널 › 접속 토큰에 같은 값 입력). 실제 발송 모드에서는 필수
API_TOKEN=

# SOLAPI 콘솔 › API Key 관리
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# SOLAPI 콘솔 › 카카오 채널 연동 후 발급되는 채널 ID (pfId)
SOLAPI_PFID=
# 알림톡 실패 시 대체 문자 발신번호 (SOLAPI에 등록된 번호, 숫자만)
SENDER_PHONE=

# SOLAPI 웹훅 주소: https://서버주소/api/solapi/webhook?key=이값
WEBHOOK_KEY=

# 앱을 다른 주소에서 열 때만 지정 (기본 *)
APP_ORIGIN=
# DB_FILE=data/messages.db
